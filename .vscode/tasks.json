{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Chess Engine w/o Profiling",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "${workspaceFolder}/src/*.cpp",
                "-o",
                "${workspaceFolder}/output/engine"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "shell",
            "label": "Build Chess Engine w/ Profiling",
            "command": "/usr/bin/g++",
            "args": [
                "-O3",
                "-fno-omit-frame-pointer",
                "-g",
                "${workspaceFolder}/src/*.cpp",
                "-o",
                "${workspaceFolder}/output/engine"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "shell",
            "label": "Copy executable to GUI folder",
            "command": "/usr/bin/cp",
            "args": [
                "${workspaceFolder}/output/engine",
                "${workspaceFolder}/Chess-GUI-for-UCI/Resources/engines/engine"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Chess Engine",
            "dependsOn": [
                "Build Chess Engine w/o Profiling",
                "Copy executable to GUI folder"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Chess Engine with Profiling",
            "dependsOn": [
                "Build Chess Engine w/ Profiling",
                "Copy executable to GUI folder"
            ],
            "dependsOrder": "sequence"
        }
    ]
}